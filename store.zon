// What the store lists, each from its repository's releases: the newest
// build (its "build-<commit>" release), or the one `.build` names to hold
// it at a build. The system (its updates), the language packs built with
// it (each <name>.tar.xz in its build's release), and the apps (each
// repository's catalogue's).
.{
    .system = .{ .repository = "dazzleos/dazzle" },
    .languages = .{
        .{ .name = "dazzle-language-ja", .language = "ja", .title = "Japanese input", .description = "Converts kana to kanji a phrase at a time" },
    },
    .apps = .{
        .{ .repository = "dazzleos/files" },
        .{ .repository = "dazzleos/camera" },
        .{ .repository = "dazzleos/text-editor" },
        .{ .repository = "dazzleos/chat" },
        .{ .repository = "dazzleos/terminal" },
        .{ .repository = "dazzleos/motu" },
        .{ .repository = "dazzleos/globe" },
        .{ .repository = "dazzleos/develop" },
        .{ .repository = "dazzleos/geppetto" },
    },
}
