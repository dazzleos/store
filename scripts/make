#!/bin/sh
# Makes the store's catalogue and the system's update, zig-out/store/
# apps.json and os.json (when there is a build of the system): the system and each app in store.zon from its
# build's release, downloaded into fetched/<repository>/, then checked
# and signed by mkstore.
#
# A repository's build is the one store.zon holds it at, else its newest:
# the "build-<commit>" release of the commit its "latest" release's
# catalogue (or, for the system, os.json) is of. While that is not there (as while its build is being
# published), what it gives is as the store's published catalogue (or
# update) has it, if from a build; never from "latest", whose files change.
#
# Needs curl and jq, and the signing key in DAZZLE_SIGNING_KEY (its 64 hex
# digits, or a file of them). ZIG is the zig to build with; STORE the
# published catalogue's place.
set -eu
cd "$(dirname "$0")/.."
zig=${ZIG:-zig}
store=${STORE:-https://github.com/dazzleos/store/releases/latest/download}
"$zig" build
version=$(git rev-parse --short=7 HEAD 2>/dev/null || echo unknown)

# Downloads $1 to $2, printing the HTTP status.
get() {
    curl -sSL -o "$2" -w '%{http_code}' "$1"
}

fail() {
    echo "$1" >&2
    exit 1
}

# The build of repository $1 to list ($2: the one store.zon holds it at,
# or "-"), its manifest $4 (apps.json, or the system's os.json) downloaded
# into $3: prints its tag, or "-" if it has none (yet).
build_of() {
    releases=https://github.com/$1/releases/download
    if [ "$2" != - ]; then
        status=$(get "$releases/$2/$4" "$3/$4")
        [ "$status" = 200 ] || fail "$1: $2/$4: HTTP $status"
        echo "$2"
        return
    fi
    status=$(get "$releases/latest/$4" "$3/latest.json")
    case $status in
    200) tag=build-$(jq -r '.version' "$3/latest.json" | cut -c1-7)
         status=$(get "$releases/$tag/$4" "$3/$4") ;;
    esac
    case $status in
    200) echo "$tag" ;;
    404) echo - ;;
    *) fail "$1: HTTP $status" ;;
    esac
}

rm -rf fetched
mkdir -p fetched zig-out/store
set --
case $(get "$store/apps.json" fetched/published.json) in
200) set -- --previous=fetched/published.json ;;
404) ;;
*) fail "$store/apps.json: cannot get it" ;;
esac
previous=$#

{
    # The system.
    read -r repository build
    dir=fetched/$repository
    mkdir -p "$dir"
    build=$(build_of "$repository" "$build" "$dir" os.json)
    if [ "$build" = - ]; then
        # As the store has it, if from a build.
        # As the store has it, if from a build; else none (yet).
        rm -f zig-out/store/os.json
        if [ "$(get "$store/os.json" fetched/os.json)" = 200 ] &&
            jq -e '.base | test("/releases/download/build-")' fetched/os.json > /dev/null; then
            cp fetched/os.json zig-out/store/os.json
            echo "$repository: the system, kept as it was" >&2
        else
            echo "$repository: no build of the system published, so no update" >&2
        fi
    else
        releases=https://github.com/$repository/releases/download/$build
        file=$(jq -r '.file' "$dir/os.json")
        case $file in */* | .*) fail "$repository: bad file name $file" ;; esac
        curl -fsSL -o "$dir/$file" "$releases/$file"
        zig-out/bin/mkstore system zig-out/store/os.json "$repository" "$build" "$dir"
        echo "$repository: the system from $build"
    fi
    # The language packs built with it, listed as store.zon has them.
    languages=$dir/languages
    mkdir -p "$languages"
    if [ "$build" = - ]; then
        set -- "$@" "$repository" - -
    else
        for file in $(zig-out/bin/mkstore language-files store.zon); do
            curl -fsSL -o "$languages/$file" "$releases/$file"
        done
        zig-out/bin/mkstore languages store.zon "$dir/os.json" "$languages"
        set -- "$@" "$repository" "$build" "$languages"
        echo "$repository: the language packs from $build"
    fi

    # The apps.
    while read -r repository build; do
        dir=fetched/$repository
        mkdir -p "$dir"
        build=$(build_of "$repository" "$build" "$dir" apps.json)
        if [ "$build" = - ]; then
            echo "$repository: no build published, kept as it was" >&2
            set -- "$@" "$repository" - -
            continue
        fi
        for file in $(jq -r '.apps[].file' "$dir/apps.json"); do
            case $file in */* | .*) fail "$repository: bad file name $file" ;; esac
            curl -fsSL -o "$dir/$file" "https://github.com/$repository/releases/download/$build/$file"
        done
        echo "$repository: $build"
        set -- "$@" "$repository" "$build" "$dir"
    done
} <<LIST
$(zig-out/bin/mkstore list store.zon)
LIST
if [ $previous = 1 ]; then
    first=$1
    shift
    zig-out/bin/mkstore make "$first" zig-out/store/apps.json "$version" "$@"
else
    zig-out/bin/mkstore make zig-out/store/apps.json "$version" "$@"
fi
