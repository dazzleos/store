#!/bin/sh
# Makes the store's catalogue, zig-out/store/apps.json: each app in
# store.zon from its build's release, downloaded into fetched/<repository>/,
# then checked and signed by mkstore.
#
# An app's build is the one store.zon holds it at, else its newest: the
# "build-<commit>" release of the commit its "latest" release is of. While
# that is not there (as while its build is being published), the app is
# listed as the store's published catalogue lists it, if from a build; it
# is never listed from "latest", whose files change.
#
# Needs curl and jq, and the signing key in DAZZLE_SIGNING_KEY (its 64 hex
# digits, or a file of them). ZIG is the zig to build with; STORE the
# published catalogue's address.
set -eu
cd "$(dirname "$0")/.."
zig=${ZIG:-zig}
store=${STORE:-https://github.com/dazzleos/store/releases/download/latest/apps.json}
"$zig" build
version=$(git rev-parse --short=7 HEAD 2>/dev/null || echo unknown)

# Downloads $1 to $2, printing the HTTP status.
get() {
    curl -sSL -o "$2" -w '%{http_code}' "$1"
}

fail() {
    echo "$1" >&2
    exit 1
}

rm -rf fetched
mkdir fetched
set --
case $(get "$store" fetched/published.json) in
200) set -- --previous=fetched/published.json ;;
404) ;;
*) fail "$store: cannot get it" ;;
esac
previous=$#

while read -r repository build; do
    releases=https://github.com/$repository/releases/download
    dir=fetched/$repository
    mkdir -p "$dir"
    if [ "$build" = - ]; then
        status=$(get "$releases/latest/apps.json" "$dir/latest.json")
        case $status in
        200) build=build-$(jq -r '.apps[0].version' "$dir/latest.json" | cut -c1-7)
             status=$(get "$releases/$build/apps.json" "$dir/apps.json") ;;
        esac
        case $status in
        200) ;;
        404) echo "$repository: no build published, kept as it was" >&2
             set -- "$@" "$repository" - -
             continue ;;
        *) fail "$repository: $build: HTTP $status" ;;
        esac
    else
        status=$(get "$releases/$build/apps.json" "$dir/apps.json")
        [ "$status" = 200 ] || fail "$repository: $build/apps.json: HTTP $status"
    fi
    for file in $(jq -r '.apps[].file' "$dir/apps.json"); do
        case $file in */* | .*) fail "$repository: bad file name $file" ;; esac
        curl -fsSL -o "$dir/$file" "$releases/$build/$file"
    done
    echo "$repository: $build"
    set -- "$@" "$repository" "$build" "$dir"
done <<LIST
$(zig-out/bin/mkstore list store.zon)
LIST
mkdir -p zig-out/store
if [ $previous = 1 ]; then
    first=$1
    shift
    zig-out/bin/mkstore make "$first" zig-out/store/apps.json "$version" "$@"
else
    zig-out/bin/mkstore make zig-out/store/apps.json "$version" "$@"
fi
